    "df_glob_all['risk'] = df_glob_all['mean'] / df_glob_all['tasa_ref']\n",
    "df_glob_all['provincia'] = 'global'\n",
    "df_glob_all['entidad'] = 'todas'\n",
    "df_glob_all = df_glob_all[columnas_prov_ent + ['mean', 'count', 'prestamos', 'diff', 'risk']]\n",
